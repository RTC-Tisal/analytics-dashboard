# Template: copy to .env.local and fill in. This file IS committed, so never put secrets here.

# Google Cloud / BigQuery. Login comes from Application Default Credentials
# (gcloud auth application-default login --impersonate-service-account=...), never a key file.
GCP_PROJECT_ID=rtc-sales-dashboard
BQ_DATASET=sales
BQ_LOCATION=US

# HubSpot (secret: real value goes in .env or .env.local only)
HUBSPOT_SERVICE_KEY=

# YouTube (module 7). A "Desktop app" OAuth client from Google Cloud Console.
# The refresh token is filled in by: node --env-file=.env.local scripts/connect-youtube.mts
# All three are secrets: real values go in .env.local only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
